{
  "name": "bidocs-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "lint:pdf": "node scripts/bidocs-pdf-guard.js",
    "validate": "tsc --noEmit && node scripts/bidocs-pdf-guard.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/utils/pdfExportEngine.ts": [
      "eslint --fix"
    ],
    "src/components/vault/MergedPackageViewerModal.tsx": [
      "eslint --fix"
    ],
    "src/components/vault/MergedPdfViewerModal.tsx": [
      "eslint --fix"
    ],
    "src/components/vault/PdfPreviewModal.tsx": [
      "eslint --fix"
    ],
    "src/components/vault/DocumentCoverPage.tsx": [
      "eslint --fix"
    ],
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "framer-motion": "^13.0.0",
    "html2canvas": "npm:html2canvas-pro@^1.5.8",
    "lucide-react": "^1.31.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
