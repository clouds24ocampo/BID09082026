{
  "name": "bidocs-app",
  "productName": "BiDOCS",
  "description": "BiDOCS - Philippine public bidding management system (RA 9184 / RA 12009). Web, desktop and mobile.",
  "author": "Quantum Cloud Corporation",
  "license": "UNLICENSED",
  "homepage": "https://github.com/clouds24ocampo/biddingsystem",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "start": "node server.js",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "lint:pdf": "node scripts/bidocs-pdf-guard.js",
    "validate": "tsc --noEmit && node scripts/bidocs-pdf-guard.js",
    "prepare": "husky",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:start": "npm run build && node scripts/electron-run.mjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:build": "npm run build && electron-builder",
    "mobile:sync": "npm run build && cap sync",
    "android:open": "npm run mobile:sync && cap open android",
    "android:run": "npm run mobile:sync && cap run android",
    "lint": "eslint .",
    "e2e:sync": "node scripts/e2e-sync.mjs",
    "e2e:auth": "node scripts/e2e-auth.mjs",
    "mock:backend": "node scripts/mock-supabase.mjs"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "node scripts/bidocs-pdf-guard.js"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.119.0",
    "animejs": "^4.5.0",
    "express": "^5.2.1",
    "framer-motion": "^13.0.0",
    "html2canvas": "npm:html2canvas-pro@^1.5.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.31.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^9.39.5",
    "@napi-rs/canvas": "^1.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "ph.quantumcloud.bidocs",
    "productName": "BiDOCS",
    "copyright": "Copyright (c) Quantum Cloud Corporation",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
